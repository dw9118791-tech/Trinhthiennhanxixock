local function readAngles()
	local l=Cam.CFrame.LookVector
	yaw=math.atan2(-l.X,-l.Z)
	pitch=math.asin(math.clamp(l.Y,-1,1))
end

local function lookVector()
	return CFrame.fromOrientation(pitch,yaw,0).LookVector
end

--========================================================
-- FIND BOMB
--========================================================

local function findBomb()
	local origin=Cam.CFrame.Position
	local dir=Cam.CFrame.LookVector*1500

	local rp=RaycastParams.new()
	rp.FilterType=Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances={LP.Character}

	local hit=workspace:Raycast(origin,dir,rp)
	if not hit then return nil end

	local obj=hit.Instance

	for _=1,8 do
		if not obj then break end
		local n=obj.Name:lower()

		if n:find("bomb") or n:find("bom") then
			if obj:IsA("BasePart") then return obj end
			local p=obj:FindFirstChildWhichIsA("BasePart",true)
			if p then return p end
		end

		obj=obj.Parent
	end

	return nil
end

