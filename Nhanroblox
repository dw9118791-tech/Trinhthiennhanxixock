	clearThermal()

	thermal=false
	bomb=nil

	HUD.Visible=false
	controls.Visible=false
	irOverlay.Visible=false

	if sound.IsPlaying then sound:Stop() end

	Cam.CameraType=Enum.CameraType.Custom

	droneBtn.Text="🚁 DRONE: TẮT"
	bombBtn.Text="💣 CHỌN BOM"
	irBtn.Text="🔥 IR: TẮT"

	lastPos=nil
	flightStart=0
	maxAlt=0
	home=nil
	homeSet=false
end

local function startDrone()
	if not bomb then bomb=findBomb() end

	if not bomb then
		droneBtn.Text="🚁 CHƯA CHỌN BOM"
		task.delay(1,function()
			if not drone then droneBtn.Text="🚁 DRONE: TẮT" end
		end)
		return
	end

	readAngles()
	setupPhysics(bomb)

	drone=true
	bombFlying=true

	-- IR tự động bật
	thermal=true

	flightStart=os.clock()
	lastPos=bomb.Position
	lastTick=os.clock()
	maxAlt=bomb.Position.Y

	home=bomb.Position
	homeSet=true

	Cam.CameraType=Enum.CameraType.Scriptable

	droneBtn.Text="🚁 DRONE: BẬT"
	HUD.Visible=true
	controls.Visible=true

	updateIR()

	if not sound.IsPlaying then sound:Play() end
end

droneBtn.Activated:Connect(function()
	if drone then stopDrone() else startDrone() end
end)

--========================================================
-- CAMERA MODE / SPEED
--========================================================

local function updateCam()
	camBtn.Text=THIRD and "🎥 GÓC NHÌN: 3D" or "🎥 GÓC NHÌN: FPV"
end

camBtn.Activated:Connect(function()
	THIRD=not THIRD
	updateCam()
end)

local function updateSpeed()
	speedLbl.Text="SPEED "..SPEED
end

speedDown.Activated:Connect(function()
	SPEED=math.max(MIN,SPEED-50)
	updateSpeed()
end)

speedUp.Activated:Connect(function()
	SPEED=math.min(MAX,SPEED+50)
	updateSpeed()
end)

--========================================================
-- FREE CAMERA
--========================================================

local camTouch,lastTouch

local function controlUI(o)
	return o:IsDescendantOf(menu)
		or o:IsDescendantOf(controls)
		or o==toggle
end

UIS.InputBegan:Connect(function(i)
	if not drone then return end

	if i.UserInputType==Enum.UserInputType.Touch then
		local p=i.Position

		for _,o in ipairs(GUI:GetGuiObjectsAtPosition(p.X,p.Y)) do
			if controlUI(o) then return end
		end

		camTouch=i
		lastTouch=p

	elseif i.UserInputType==Enum.UserInputType.MouseButton2 then
		camTouch=i
		lastTouch=i.Position
	end
end)

UIS.InputChanged:Connect(function(i)
	if not drone or i~=camTouch then return end

	local p=i.Position
	local d=p-lastTouch
	lastTouch=p

	yaw-=d.X*SENS
	pitch-=d.Y*SENS
	pitch=math.clamp(pitch,math.rad(-85),math.rad(85))
end)

UIS.InputEnded:Connect(function(i)
	if i==camTouch then
		camTouch=nil
		lastTouch=nil
	end
end)

--========================================================
-- KEYBOARD
--========================================================

UIS.InputBegan:Connect(function(i,gp)
	if gp then return end

	local k=i.KeyCode

	if k==Enum.KeyCode.F then
		if drone then stopDrone() else startDrone() end

	elseif k==Enum.KeyCode.V then
		THIRD=not THIRD
		updateCam()

	elseif k==Enum.KeyCode.T and drone then
		thermal=not thermal
		if not thermal then clearThermal() end
		updateIR()

	elseif k==Enum.KeyCode.W then fw=true
	elseif k==Enum.KeyCode.S then bw=true
	elseif k==Enum.KeyCode.A then lf=true
	elseif k==Enum.KeyCode.D then rt=true

	elseif k==Enum.KeyCode.Q then
		SPEED=math.max(MIN,SPEED-50)
		updateSpeed()

	elseif k==Enum.KeyCode.E then
		SPEED=math.min(MAX,SPEED+50)
		updateSpeed()
	end
end)

UIS.InputEnded:Connect(function(i)
	if i.KeyCode==Enum.KeyCode.W then fw=false
	elseif i.KeyCode==Enum.KeyCode.S then bw=false
	elseif i.KeyCode==Enum.KeyCode.A then lf=false
	elseif i.KeyCode==Enum.KeyCode.D then rt=false
	end
end)

--========================================================
-- HUD UPDATE
--========================================================

local function updateHUD(head,pitchDeg,altitude,speed,climb,pos)
	local runtime=os.clock()-flightStart

	rec.Text=string.format("● REC %05.1fs",runtime)
	gps.Text=string.format(
		"GPS %02d SAT // LOCK %03d%%",
		sats,
		math.clamp(100-math.abs(pitchDeg)*.15,82,100)
	)

	modeTxt.Text="MODE "..mode
	gpsTxt.Text=string.format("GPS %02d SAT",sats)
	hdopTxt.Text=string.format("HDOP %.1f",hdop)
	rssiTxt.Text=string.format("RSSI %d dBm",rssi)
	latTxt.Text=string.format("LAT %dms",latency)
	payloadTxt.Text="PAYLOAD "..payload

	if math.abs(pitchDeg)>70 then
		warn.Text="⚠ HIGH PITCH"
		warn.TextColor3=RED
		flightStatus.Text="FLIGHT WARNING"
		flightStatus.TextColor3=RED

	elseif speed>MAX*.9 then
		warn.Text="⚠ HIGH AIRSPEED"
		warn.TextColor3=RED
		flightStatus.Text="SPEED LIMIT"
		flightStatus.TextColor3=RED

	elseif altitude<10 then
		warn.Text="⚠ LOW ALTITUDE"
		warn.TextColor3=AMBER
		flightStatus.Text="LOW ALTITUDE"
		flightStatus.TextColor3=AMBER

	else
		warn.Text="SYSTEM NORMAL"
		warn.TextColor3=GREEN
		flightStatus.Text="FLIGHT CONTROL: ACTIVE"
		flightStatus.TextColor3=GREEN
	end

	local off=math.clamp(pitchDeg,-30,30)*5

	hLine.Position=UDim2.new(.5,-380,.5,off)
	cLine.Position=UDim2.new(.5,-95,.5,off)

	for _,v in ipairs(ladder) do
		local y=off+v.deg*5
		v.line.Position=UDim2.new(.5,-v.w/2,.5,y)
		v.label.Position=UDim2.new(.5,-v.w/2-35,.5,y-9)
	end

	head=math.floor(head)%360

	local h={
		(head+330)%360,
		head,
		(head+30)%360,
		(head+60)%360,
		(head+90)%360,
		(head+120)%360,
		(head+150)%360
	}

	compassTxt.Text=string.format(
		"%03d   %03d   %03d   %03d   %03d   %03d   %03d",
		h[1],h[2],h[3],h[4],h[5],h[6],h[7]
	)

	pointer.Text=
		head<45 and "N"
		or head<135 and "E"
		or head<225 and "S"
		or head<315 and "W"
		or "N"

	alt.Text=string.format("%04d",math.max(0,math.floor(altitude)))
	maxAltTxt.Text=string.format("MAX %04d",math.floor(maxAlt))
	vsTxt.Text=string.format("V/S %+04d",math.floor(climb))

	airBig.Text=string.format("%03d",math.floor(speed))
	ground.Text=string.format("GS %03d",math.floor(speed))
	fovTxt.Text=string.format("FOV %d°",fov)

	local px=math.clamp(yaw/math.pi,-.45,.45)
	local py=math.clamp(-pitchDeg/90,-.38,.38)

	fpv.Position=UDim2.new(.5,px*300,.5,py*220)

	teleL.Text=string.format(
		"ROLL +00°\nPITCH %+03d°\nYAW %03d°\nACC %03d",
		math.floor(pitchDeg),
		math.floor(head),
		math.floor(speed)
	)

	teleR.Text=string.format(
		"CAM %s\nFOV %d°\nHDG %03d°\nLINK OK",
		THIRD and "3D" or "FPV",
		fov,
		math.floor(head)
	)

	local battery=math.clamp(100-runtime/120,65,100)
	local signal=math.clamp(100-math.abs(pitchDeg)*.15,82,100)

	bottom.Text=string.format(
		"BAT %03d%% | SIGNAL %03d%% | LINK STABLE | IMU OK",
		battery,
		signal
	)

	if homeSet and home then
		local delta=home-pos
		local dist=delta.Magnitude

		local bearing=math.deg(math.atan2(delta.X,-delta.Z))
		if bearing<0 then bearing+=360 end

		local rel=(bearing-head+360)%360

		homeDist.Text=string.format(
			"HOME %04d STUDS",
			math.floor(dist)
		)

		homeBrg.Text=string.format(
			"BRG %03d°",
			math.floor(bearing)
		)

		local arrow=
			rel<22.5 or rel>337.5 and "▲"
			or rel<67.5 and "↗"
			or rel<112.5 and "→"
			or rel<157.5 and "↘"
			or rel<202.5 and "▼"
			or rel<247.5 and "↙"
			or rel<292.5 and "←"
			or "↖"

		homeArrow.Text="HOME "..arrow
	end

	coords.Text=string.format(
		"X %+07.1f | Y %+07.1f | Z %+07.1f",
		pos.X,pos.Y,pos.Z
	)

	if thermal then updateThermal() end
end

--========================================================
-- MAIN FLIGHT LOOP
--========================================================

RS.RenderStepped:Connect(function()
	if not drone or not bombFlying or not bomb then
		HUD.Visible=false
		controls.Visible=false
		clearThermal()
		return
	end

	if not bomb.Parent then
		stopDrone()
		return
	end

	HUD.Visible=true
	controls.Visible=true

	local look=lookVector()
	local cf=CFrame.lookAt(Vector3.zero,look)
	local right=cf.RightVector
	local dir=Vector3.zero

	if fw then dir+=look end
	if bw then dir-=look end
	if lf then dir-=right end
	if rt then dir+=right end

	if dir.Magnitude>0 then dir=dir.Unit end

	if velocity then
		velocity.VectorVelocity=dir*SPEED
	end

	if orientation and dir.Magnitude>0 then
		orientation.CFrame=CFrame.lookAt(Vector3.zero,dir)
	end

	Cam.CameraType=Enum.CameraType.Scriptable

	if THIRD then
		local cp=bomb.Position-look*CAMDIST+Vector3.new(0,6,0)
		Cam.CFrame=CFrame.lookAt(cp,cp+look)
	else
		Cam.CFrame=CFrame.lookAt(
			bomb.Position,
			bomb.Position+look
		)
	end

	local now=os.clock()
	local dt=math.max(now-lastTick,.001)
	local pos=bomb.Position
	local altitude=pos.Y

	maxAlt=math.max(maxAlt,altitude)

	local speed=0
	if lastPos then
		speed=(pos-lastPos).Magnitude/dt
	end

	lastPos=pos
	lastTick=now

	local heading=math.deg(math.atan2(-look.X,-look.Z))
	if heading<0 then heading+=360 end

	local pitchDeg=math.deg(pitch)
	local climb=look.Y*SPEED

	updateHUD(
		heading,
		pitchDeg,
		altitude,
		speed,
		climb,
		pos
	)
end)

