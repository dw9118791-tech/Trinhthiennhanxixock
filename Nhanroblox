--========================================================
-- THERMAL
--========================================================

local function clearThermal()
	for _,h in pairs(thermalList) do
		if h then h:Destroy() end
	end
	table.clear(thermalList)
end

local function addThermal(plr)
	if plr==LP or not plr.Character or thermalList[plr] then return end

	local c=plr.Character
	local root=c:FindFirstChild("HumanoidRootPart")
	local hum=c:FindFirstChildOfClass("Humanoid")

	if not root or not hum or hum.Health<=0 then return end

	local h=Instance.new("Highlight")
	h.Name="IR_THERMAL_TARGET"
	h.Adornee=c
	h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	h.FillColor=IRR
	h.OutlineColor=IRW
	h.FillTransparency=.35
	h.OutlineTransparency=.05
	h.Parent=c

	thermalList[plr]=h
end

local function updateThermal()
	if not thermal or not drone then
		clearThermal()
		return
	end

	local origin=Cam.CFrame.Position
	local closest,closestD=nil,math.huge

	for _,plr in ipairs(P:GetPlayers()) do
		if plr~=LP and plr.Character then
			local root=plr.Character:FindFirstChild("HumanoidRootPart")
			local hum=plr.Character:FindFirstChildOfClass("Humanoid")

			if root and hum and hum.Health>0 then
				local d=(root.Position-origin).Magnitude

				if d<=thermalRange then
					addThermal(plr)

					local sp,on=Cam:WorldToViewportPoint(root.Position)
					if on then
						local c=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
						local p=Vector2.new(sp.X,sp.Y)
						local sd=(p-c).Magnitude

						if sd<closestD then
							closestD=sd
							closest={p=plr,d=d}
						end
					end
				end
			end
		end
	end

	for plr,h in pairs(thermalList) do
		if not plr.Character then
			h:Destroy()
			thermalList[plr]=nil
		else
			local r=plr.Character:FindFirstChild("HumanoidRootPart")
			if not r or (r.Position-origin).Magnitude>thermalRange then
				h:Destroy()
				thermalList[plr]=nil
			end
		end
	end

	if closest then
		irTarget.Text="THERMAL: "..closest.p.DisplayName:upper()
		irTarget.TextColor3=IRR
		irRange.Text=string.format("RNG %04d STUDS",math.floor(closest.d))
	else
		irTarget.Text="NO THERMAL TARGET"
		irTarget.TextColor3=IRG
		irRange.Text="RNG ----"
	end
end

local function updateIR()
	irBtn.Text=thermal and "🔥 IR: BẬT" or "🔥 IR: TẮT"
	irOverlay.Visible=thermal and drone
end

irBtn.Activated:Connect(function()
